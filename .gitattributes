# ==============================================================================
# Git Attributes: Mis Seguros (Cross-Platform Windows / Linux / macOS)
# ==============================================================================

# Set default behavior to automatically normalize line endings to LF on commit
* text=auto eol=lf

# ------------------------------------------------------------------------------
# Shell scripts and executables (MUST BE LF to avoid /bin/sh^M syntax errors)
# ------------------------------------------------------------------------------
gradlew                 text eol=lf
*.sh                    text eol=lf
*.bash                  text eol=lf
*.zsh                   text eol=lf

# ------------------------------------------------------------------------------
# Windows-specific scripts (MUST BE CRLF for CMD and PowerShell compatibility)
# ------------------------------------------------------------------------------
gradlew.bat             text eol=crlf
*.bat                   text eol=crlf
*.cmd                   text eol=crlf
*.ps1                   text eol=crlf

# ------------------------------------------------------------------------------
# Kotlin & JVM Source Code (Enforce LF for consistency across OSes)
# ------------------------------------------------------------------------------
*.kt                    text eol=lf
*.kts                   text eol=lf
*.java                  text eol=lf
*.groovy                text eol=lf

# ------------------------------------------------------------------------------
# Configuration, Build & Manifest files
# ------------------------------------------------------------------------------
*.toml                  text eol=lf
*.properties            text eol=lf
*.xml                   text eol=lf
*.json                  text eol=lf
*.yml                   text eol=lf
*.yaml                  text eol=lf
*.md                    text eol=lf
*.txt                   text eol=lf
*.html                  text eol=lf
*.css                   text eol=lf
*.js                    text eol=lf
*.mjs                   text eol=lf
*.wasm                  binary

# ------------------------------------------------------------------------------
# Git & Project Configs
# ------------------------------------------------------------------------------
.gitignore              text eol=lf
.gitattributes          text eol=lf
.editorconfig           text eol=lf

# ------------------------------------------------------------------------------
# Binary files (Never modify line endings to prevent corruption)
# ------------------------------------------------------------------------------
*.jar                   binary
*.war                   binary
*.ear                   binary
*.zip                   binary
*.tar                   binary
*.tar.gz                binary
*.tgz                   binary
*.7z                    binary
*.png                   binary
*.jpg                   binary
*.jpeg                  binary
*.gif                   binary
*.webp                  binary
*.ico                   binary
*.svg                   text eol=lf
*.pdf                   binary
*.keystore              binary
*.jks                   binary
*.exe                   binary
*.dll                   binary
*.so                    binary
*.dylib                 binary
